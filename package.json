{
  "name": "video-mcp-server",
  "version": "1.3.0",
  "description": "Local-first video understanding for AI agents, plus `video-mcp sort`: sort a shoot folder by topic, A/B roll and quality using the Claude, Codex or Grok CLI you are signed in to",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "video-mcp": "dist/index.js",
    "video-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "smoke": "tsx scripts/smoke.mts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "video",
    "ffmpeg",
    "whisper",
    "claude",
    "codex",
    "agent",
    "footage",
    "a-roll",
    "b-roll",
    "video-editing",
    "grok"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "homepage": "https://videomcp.n3el.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neelsatyavolu/videomcp.git"
  },
  "bugs": {
    "url": "https://github.com/neelsatyavolu/videomcp/issues"
  },
  "author": "Neel Satyavolu"
}
